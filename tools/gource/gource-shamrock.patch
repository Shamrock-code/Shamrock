+void Gource::drawUserCommitCounts(float dt) {
+    static const int max_rows = getenv("GOURCE_USER_COUNTS") ? atoi(getenv("GOURCE_USER_COUNTS")) : 0;
+
+    if(max_rows <= 0 || user_commit_counts.empty()) return;
+
+    std::vector<std::pair<std::string, UserCommitCount*> > ranked;
+    for(std::map<std::string, UserCommitCount>::iterator it = user_commit_counts.begin(); it != user_commit_counts.end(); it++) {
+        ranked.push_back(std::make_pair(it->first, &it->second));
+    }
+    std::sort(ranked.begin(), ranked.end(),
+        [](const std::pair<std::string, UserCommitCount*>& a, const std::pair<std::string, UserCommitCount*>& b) {
+            if(a.second->count != b.second->count) return a.second->count > b.second->count;
+            return a.first < b.first;
+        });
+
+    const float text_h    = fontmedium.getMaxHeight();
+    const float icon_size = glm::floor(text_h * 1.2f);
+    const float fs        = gGourceSettings.font_scale;
+    const float row_h     = glm::max(text_h, icon_size) + 6.0f * fs;
+    const float right_x   = display.width - 20.0f * fs;
+    const float top_y     = 20.0f * fs;
+    const float count_w   = fontmedium.getWidth("00000");
+    const float name_r    = right_x - count_w - 12.0f * fs;
+    const float ease      = glm::min(1.0f, dt * 6.0f);
+
+    fontmedium.setColour(vec4(gGourceSettings.font_colour, 0.7f));
+    std::string header = "Commits";
+    fontmedium.draw(right_x - fontmedium.getWidth(header), top_y, header);
+
+    for(size_t i = 0; i < ranked.size(); i++) {
+        UserCommitCount& e = *ranked[i].second;
+
+        int   row      = (int) glm::min(i, (size_t) max_rows);
+        float target_y = top_y + (row + 1) * row_h;
+        float target_a = ((int) i < max_rows) ? 1.0f : 0.0f;
+
+        if(e.y < 0.0f) e.y = target_y;
+        e.y     += (target_y - e.y) * ease;
+        e.alpha += (target_a - e.alpha) * ease;
+
+        if(e.alpha < 0.01f) continue;
+
+        const std::string& name = ranked[i].first;
+        char count_str[32];
+        snprintf(count_str, sizeof(count_str), "%d", e.count);
+
+        float text_y = glm::floor(e.y + (row_h - text_h) * 0.5f - 3.0f * fs);
+        float name_w = fontmedium.getWidth(name);
+
+        if(e.icon != 0) {
+            float ix = glm::floor(name_r - name_w - 8.0f * fs - icon_size);
+            float iy = glm::floor(e.y);
+
+            glEnable(GL_BLEND);
+            glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+            glEnable(GL_TEXTURE_2D);
+            glBindTexture(GL_TEXTURE_2D, e.icon->textureid);
+            glColor4f(1.0f, 1.0f, 1.0f, e.alpha);
+
+            glBegin(GL_QUADS);
+                glTexCoord2f(0.0f,0.0f); glVertex2f(ix,             iy);
+                glTexCoord2f(1.0f,0.0f); glVertex2f(ix + icon_size, iy);
+                glTexCoord2f(1.0f,1.0f); glVertex2f(ix + icon_size, iy + icon_size);
+                glTexCoord2f(0.0f,1.0f); glVertex2f(ix,             iy + icon_size);
+            glEnd();
+        }
+
+        fontmedium.setColour(vec4(gGourceSettings.highlight_colour, e.alpha));
+        fontmedium.draw(name_r - name_w, text_y, name);
+
+        fontmedium.setColour(vec4(gGourceSettings.font_colour, e.alpha));
+        fontmedium.draw(right_x - fontmedium.getWidth(count_str), text_y, count_str);
+    }
+
+    fontmedium.setColour(vec4(gGourceSettings.font_colour, 1.0f));
+}
